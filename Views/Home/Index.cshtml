@{
    ViewData["Title"] = "GameStore";
}

<section class="home-page">
    <div class="home-page__content">
        <p class="eyebrow">Console Game Store</p>
        <h1>Каталог игр уже готов</h1>
        <p>Откройте витрину магазина, выберите игру для нужной консоли и добавьте ее во временную гостевую корзину.</p>
        <a class="btn btn-primary" asp-controller="Catalog" asp-action="Index">Перейти в каталог</a>
    </div>
</section>
